# ToolkitLife environment variables (copy to .env.local — never commit .env.local)
#
# ── Real address generator (integration with self-hosted Address API) ──────
# See docs/address-deployment.md for how to run the Address service itself.
#
# Master switch. When "false" (default) the address generator only offers the
# browser-side simulated (Faker) mode and the /api/address-generator routes
# return 503 REAL_MODE_DISABLED.
ADDRESS_REAL_ENABLED=false

# Base origin of the private Address API deployment, e.g. https://address.internal
# or http://127.0.0.1:8787. The adapter normalizes this to a bare origin and
# only calls an allowlist of /api/v1/... paths on it.
ADDRESS_API_BASE_URL=

# Bearer token created in the Address admin console ("接口令牌"). Server-only:
# never expose via NEXT_PUBLIC_*.
ADDRESS_API_TOKEN=
